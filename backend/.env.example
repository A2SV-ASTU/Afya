PORT=8080
ENV=development

# Database configuration
DB_DSN=postgres://user:password@localhost:5432/afyamind?sslmode=disable

# JWT configuration
JWT_SECRET=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Cookie configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# SMTP / Email Configuration (For Sending Invitations)
# 1. Enter details from your email provider (e.g., SendGrid, Mailgun, Resend, or AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_production_smtp_password_here
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME="Afya"

# Magic Link / Base URL (used for clickable links in emails)
# Set to your deployed backend URL in production (e.g., https://api.afya.com)
API_BASE_URL=http://localhost:8080
