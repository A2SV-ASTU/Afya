PORT=8080
ENV=development

# Database configuration
DB_DSN=postgres://user:password@localhost:5432/afyamind?sslmode=disable

# JWT configuration
JWT_SECRET=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRY_MINUTES=15
